{
  "devDependencies": {
    "biome": "^0.3.3",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "biome format"
    ],
    "*.{css,scss,md,json,html}": [
      "prettier --write"
    ]
  }
}
