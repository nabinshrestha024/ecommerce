#!/bin/sh
commit_regex='^(FE-|BE-)(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z]+\))?: .{1,72}$'

if ! grep -qE "$commit_regex" "$1"; then
    echo "❌ Invalid commit message format!"
    echo ""
    echo "Expected format: <sector><type>(<scope>): <subject>"
    echo ""
    echo "Sector: FE-, BE-"
    echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore"
    echo "Example: feat(auth): add login endpoint"
    echo ""
    exit 1
fi
