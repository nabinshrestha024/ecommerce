#############################

*.orig
*.rej

#############################
##     PROJECT SPECIFIC    ##
#############################

## Email templates
src/**/EmailTemplates/*/*.html
src/**/EmailTemplates/*/*.txt

## Local file storage uploads
src/**/FileStorage/Uploads/

## Cache for payment services
src/**/Payments/**/cache/

## Push notification tokens
src/**/Notification/**/token_cache/

## Any temporary generate folders
tmp/
temp/
generated/

#############################
##        CLEANUP          ##
#############################

# Ignore everything in target but keep config files
target/*
!target/*.config
