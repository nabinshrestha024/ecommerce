#!/bin/sh

cd "$(dirname "$0")/.."

dotnet restore EcommerceProject/EcommerceProject.csproj || exit 1
dotnet build EcommerceProject/EcommerceProject.csproj || exit 1#!/bin/sh

echo "--------------------------------------------------"
echo "🚀 Pre-push checks started"
echo "📂 Switching to backend directory..."
echo "--------------------------------------------------"

# Move to backend directory
cd "$(dirname "$0")/.." || {
  echo "❌ Failed to switch to backend directory"
  exit 1
}

PROJECT_PATH="EcommerceProject/EcommerceProject.csproj"

echo "📦 Restoring .NET dependencies..."
dotnet restore "$PROJECT_PATH"
if [ $? -ne 0 ]; then
  echo "❌ dotnet restore failed"
  echo "⛔ Push aborted"
  exit 1
fi

echo "🔨 Building backend project..."
dotnet build "$PROJECT_PATH"
if [ $? -ne 0 ]; then
  echo "❌ dotnet build failed"
  echo "⛔ Push aborted"
  exit 1
fi

echo "--------------------------------------------------"
echo "✅ Pre-push checks passed successfully"
echo "🚢 Proceeding with git push..."
echo "--------------------------------------------------"

exit 0
